{
  "manifest_version": 3,
  "name": "wgb-companion — webchat goal bridge",
  "version": "1.3.0",
  "description": "Chat web làm NÃO chỉ đạo, agent local làm TAY CHÂN: gõ '@wgb <task>' trong ChatGPT/Gemini/Claude, extension dispatch qua wgb serve (127.0.0.1:8787) rồi điền kết quả về chat để duyệt. Thay thế Muse.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "wgb-companion"
  }
}
